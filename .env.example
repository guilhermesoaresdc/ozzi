# Supabase (projeto Ozzi)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=service-role-key-somente-no-servidor

# Loja
NEXT_PUBLIC_SITE_URL=https://ozzi.vercel.app
NEXT_PUBLIC_WHATSAPP=5588999990000

# Provador virtual (IA que veste a peça na foto da cliente)
# Sem estas variáveis o provador aparece desligado, com recado honesto.
PROVADOR_PROVEDOR=gemini          # gemini | openai | fal
PROVADOR_API_KEY=                 # chave do provedor escolhido
PROVADOR_MODELO=                  # opcional, sobrescreve o modelo padrão

# Necessária para o provador: as fotos das clientes ficam em bucket privado,
# e quem não tem conta não pode ser dono de arquivo sob RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Consultoria de cor (análise de coloração pessoal com Claude)
# Diferente do provador: aqui é análise de imagem, que o Claude faz direto.
ANTHROPIC_API_KEY=
